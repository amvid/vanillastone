{
  "lsp": {
    "deno": {
      "settings": {
        "deno": {
          "enable": true,
          "enablePaths": ["web", "desktop"],
          "config": "web/deno.json"
        }
      }
    }
  },
  "languages": {
    "TypeScript": {
      "language_servers": ["deno", "!typescript-language-server", "!vtsls", "!eslint", "!biome"],
      "formatter": "language_server"
    },
    "TSX": {
      "language_servers": ["deno", "!typescript-language-server", "!vtsls", "!eslint", "!biome"],
      "formatter": "language_server"
    },
    "JavaScript": {
      "language_servers": ["deno", "!typescript-language-server", "!vtsls", "!eslint", "!biome"],
      "formatter": "language_server"
    },
    "JSON": {
      "language_servers": ["deno", "!biome"],
      "formatter": "language_server"
    },
    "JSONC": {
      "language_servers": ["deno", "!biome"],
      "formatter": "language_server"
    }
  }
}
