{
  "nodeModulesDir": "auto",
  "unstable": ["sloppy-imports"],
  "exclude": ["node_modules", "static", "dist"],
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-window",
        "no-window-prefix",
        "no-sloppy-imports"
      ]
    }
  },
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno check src && deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "check": "deno check src"
  },
  "allowScripts": ["npm:@swc/core"]
}
